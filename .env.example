# Copy to .env.local (never commit .env.local) and fill in what you use.
# Demo mode needs none of this. Live mode needs the first block.

# ── Live mode ──────────────────────────────────────────────
# `npm run dev:live` / hosting sets APP_MODE=live; leave it out here so `npm run dev` still opens the demo.
# APP_MODE=live
APP_PASSWORD=            # the password you type on the login page
AUTH_SECRET=             # long random string: run `openssl rand -base64 32`
CRON_SECRET=             # another random string; the daily job must send it
APP_URL=http://localhost:3000   # your public address once hosted (used in OAuth redirects + report links)
# DATABASE_PATH=data/creator-os-live.db   # optional override

# ── Go API (backend/) ─────────────────────────────────────
# The Overview, Brands, Pipeline and Finance pages get their data from this API. ./start.sh starts it for you.
# API_URL=http://127.0.0.1:8080   # where the frontend finds the API
# API_PORT=8080                    # port the API listens on
# API_TOKEN=                       # optional shared secret: the API requires it and the frontend sends it (set it if the API is ever reachable beyond this computer)

# ── YouTube + Gmail (Google Cloud → APIs & Services → Credentials → OAuth client, type "Web application")
# Redirect URI to register: <APP_URL>/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Instagram (Meta for Developers → app with "Instagram API with Instagram Login")
# Redirect URI to register: <APP_URL>/api/connect/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── TikTok (developers.tiktok.com → app with Login Kit + Display API)
# Redirect URI to register: <APP_URL>/api/connect/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── LINE Official Account (LINE Developers → Messaging API channel)
# Webhook URL to set: <APP_URL>/api/webhooks/line
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Optional: answer Ask AI with Claude instead of the offline engine
ANTHROPIC_API_KEY=

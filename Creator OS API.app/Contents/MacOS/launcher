#!/bin/bash
# Double-click launcher for the Creator OS backend only (the Go API, live mode, your real data), then opens
# its front page in the browser. Double-click again while it is running to Open it or Stop it.
# (Creator OS.app starts the API and the web app together; use this one when you only want the API.)
#
# Keep "Creator OS API.app" inside the Creator OS project folder: it finds the project from its own location.

MODE=live
API_PORT=8080

APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
URL="http://127.0.0.1:$API_PORT/"
LOG="$APP_DIR/.run/launcher-api.log"

# Apps started from Finder get a bare PATH; add the usual places for node and go.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:$HOME/go/bin:$PATH"

alert() { /usr/bin/osascript -e 'on run argv' -e 'display dialog (item 1 of argv) with title "Creator OS API" buttons {"OK"} default button "OK" with icon caution' -e 'end run' "$1" >/dev/null 2>&1; }
notify() { /usr/bin/osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "Creator OS API"' -e 'end run' "$1" >/dev/null 2>&1; }
ask_running() {
  /usr/bin/osascript -e 'display dialog "The Creator OS API is already running." with title "Creator OS API" buttons {"Stop", "Open"} default button "Open" with icon note' -e 'button returned of result' 2>/dev/null
}

if [ ! -x "$APP_DIR/start.sh" ] || [ ! -d "$APP_DIR/backend" ]; then
  alert "Can't find the backend next to Creator OS API.app. Keep the app inside the Creator OS project folder."
  exit 1
fi
cd "$APP_DIR" || exit 1
mkdir -p .run

api_up() { curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$API_PORT/api/v1/health" 2>/dev/null; }
alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

stop_api() {
  if alive .run/api.pid; then
    pid=$(cat .run/api.pid)
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 20); do alive .run/api.pid || break; sleep 0.25; done
    alive .run/api.pid && { kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null; }
  fi
  rm -f .run/api.pid
}

if api_up; then
  choice=$(ask_running) || exit 0
  if [ "$choice" = "Stop" ]; then
    stop_api
    if api_up; then
      alert "The API is still answering on port $API_PORT. It wasn't started by this app, so stop it from a terminal (./stop.sh)."
    else
      notify "Creator OS API stopped. (The web app can't load data until the API is running again.)"
    fi
  else
    open "$URL"
  fi
  exit 0
fi

# A leftover pid from a crashed run would make us think it's running.
alive .run/api.pid || rm -f .run/api.pid

notify "Starting the API…"

(
  [ -f data/creator-os-live.db ] || { echo "No live database yet. Run: npm run setup:live"; exit 1; }
  APP_MODE=live npm run -s migrate >/dev/null || exit 1   # keeps your data, adds any new columns
  echo "Building the Go API…"
  (cd backend && go build -o bin/creator-os-api ./cmd/server) || exit 1

  set -m   # own process group, so Stop can end it cleanly
  (cd backend && APP_MODE=live API_PORT="$API_PORT" exec ./bin/creator-os-api) >.run/api.log 2>&1 &
  echo $! >.run/api.pid
  for _ in $(seq 1 40); do api_up && exit 0; alive .run/api.pid || { tail -n 15 .run/api.log; rm -f .run/api.pid; exit 1; }; sleep 0.5; done
  echo "The API did not answer in time."; exit 1
) >"$LOG" 2>&1

if api_up; then
  open "$URL"
else
  alert "The Creator OS API didn't start.

$(tail -n 8 "$LOG")

Full log: .run/launcher-api.log"
  exit 1
fi

{
  "name": "creator-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Creator OS — CDP + CRM prototype for solo influencers (mock data)",
  "scripts": {
    "dev": "next dev",
    "dev:live": "APP_MODE=live next dev",
    "build": "next build",
    "start": "next start",
    "start:demo": "npm run seed && next start",
    "start:live": "npm run migrate && next start",
    "seed": "tsx scripts/seed.ts",
    "setup:live": "tsx scripts/setup-live.ts",
    "migrate": "tsx scripts/migrate.ts",
    "import:workbook": "tsx scripts/import-workbook.ts",
    "verify": "tsx scripts/verify-story.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev:api": "cd backend && go run ./cmd/server",
    "dev:api:live": "cd backend && APP_MODE=live go run ./cmd/server",
    "build:api": "cd backend && go build -o bin/creator-os-api ./cmd/server",
    "test:api": "cd backend && go test ./...",
    "verify:api": "tsx scripts/verify-api.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^5.8.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@4.9.1+sha512.f95ce356460e05be48d66401c1ae64ef84d163dd689964962c6888a9810865e39097a5e9de748876c2e0bf89b232d583c33982773e9903ae7a76257270986538"
}
